# BE API 기본 주소. 비워 두면 같은 출처의 /api 로 요청한다.
# 바꾸더라도 같은 출처의 상대 경로만 쓴다. 절대 주소(http://localhost:8080/api 등)를 넣으면
# 로그인 쿠키가 붙지 않고 BE가 403 ORIGIN_MISMATCH로 거절한다 (BE docs/API.md 2.2절, 2.4절).
VITE_API_BASE_URL=

# 개발 서버의 /api 프록시 대상 (vite.config.ts 에서만 사용, 번들에 포함되지 않음).
API_PROXY_TARGET=http://localhost:8080

# true 면 MSW 목 API를 켠다. BE 없이 책 목록·본문을 볼 수 있다.
# 개발 서버(pnpm dev)와 빌드(pnpm build) 모두 이 값을 따른다. GCP 배포는 Cloud Build 트리거의 _VITE_API_MOCK=true (데모 모드).
# 자세한 것은 docs/architecture.md 3장·5장.
VITE_API_MOCK=false
