# BE API 기본 주소. 비워 두면 같은 도메인의 /api 로 요청한다.
VITE_API_BASE_URL=

# 개발 서버의 /api 프록시 대상 (vite.config.ts 에서만 사용, 번들에 포함되지 않음).
API_PROXY_TARGET=http://localhost:8080

# true 면 개발 서버(pnpm dev)에서 MSW 목 API를 켠다. BE 없이 책 목록·본문을 볼 수 있다.
# 배포 빌드에서는 이 값과 상관없이 꺼진다. 자세한 것은 docs/architecture.md 3장.
VITE_API_MOCK=false
