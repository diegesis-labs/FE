{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"],
    "ask": [
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./eslint.config.js)",
      "Edit(./steiger.config.ts)",
      "Edit(./scripts/check-guardrails.mjs)",
      "Edit(./.github/**)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" edit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" lint",
            "timeout": 60,
            "statusMessage": "ESLint 검사 중"
          }
        ]
      }
    ]
  }
}
